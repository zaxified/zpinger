#!/bin/sh
# remove keeps the env file, target list and history (and masks the unit,
# so a leftover enable link cannot start a binary that is gone); purge
# deletes them. DynamicUser keeps the state in /var/lib/private, linked
# from /var/lib.
set -e
[ -d /run/systemd/system ] && systemctl --system daemon-reload >/dev/null || true
case "$1" in
    remove)
        deb-systemd-helper mask zpinger.service >/dev/null || true
        ;;
    purge)
        deb-systemd-helper purge zpinger.service >/dev/null || true
        deb-systemd-helper unmask zpinger.service >/dev/null || true
        rm -rf /etc/zpinger /var/lib/zpinger /var/lib/private/zpinger
        ;;
esac
exit 0
